name: Publish Docker images to JFrog

on:
  push:
    branches: [main]
    tags: ['v*']
  workflow_dispatch:

permissions:
  contents: read

jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
          cache: maven

      - name: Run tests before publishing
        run: mvn -B clean verify

      - name: Set image tag
        id: meta
        shell: bash
        run: echo "tag=${GITHUB_SHA::12}" >> "$GITHUB_OUTPUT"

      - name: Login to JFrog Docker registry
        uses: docker/login-action@v3
        with:
          registry: ${{ secrets.JFROG_REGISTRY }}
          username: ${{ secrets.JFROG_USERNAME }}
          password: ${{ secrets.JFROG_PASSWORD }}

      - name: Build and push Wallet Service
        uses: docker/build-push-action@v6
        with:
          context: .
          file: wallet-service/Dockerfile
          push: true
          tags: ${{ secrets.JFROG_REGISTRY }}/docker-local/digital-wallet/wallet-service:${{ steps.meta.outputs.tag }}

      - name: Build and push KYC & Statement Service
        uses: docker/build-push-action@v6
        with:
          context: .
          file: kyc-statement-service/Dockerfile
          push: true
          tags: ${{ secrets.JFROG_REGISTRY }}/docker-local/digital-wallet/kyc-statement-service:${{ steps.meta.outputs.tag }}
